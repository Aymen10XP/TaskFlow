rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if ownsUserData(userId);

      match /tasks/{taskId} {
        allow read, write: if ownsUserData(userId);
      }

      match /categories/{categoryId} {
        allow read, write: if ownsUserData(userId);
      }
    }
  }
}
